{
  "name": "evara-timetables",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, local-first desktop school timetabling.",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@evara/desktop",
    "build": "npm run build --workspace=@evara/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:web": "npm run test --workspaces --if-present",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:fmt:fix": "cargo fmt --all",
    "rust:lint": "cargo lint -- -D warnings",
    "rust:test": "cargo test --workspace --all-features",
    "rust:build": "cargo build --workspace",
    "types:generate": "cargo run -q -p evara-desktop --features ts --bin evara-typegen",
    "types:check": "cargo run -q -p evara-desktop --features ts --bin evara-typegen -- --check",
    "check": "npm run rust:fmt && npm run rust:lint && npm run rust:test && npm run types:check && npm run typecheck && npm run test:web",
    "review:package": "node scripts/prompt-report.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
